# ==========================================
# NEXUS SHOP - SERVER ENVIRONMENT CONFIG
# ==========================================

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexus_user:nexus_password123@localhost:5432/nexus_shop?schema=public

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=nexus-shop-super-secret-access-token-key-min-32-chars!
JWT_REFRESH_SECRET=nexus-shop-super-secret-refresh-token-key-min-32-chars!

# Security & CORS
CORS_ORIGIN=http://localhost:3000

# Stripe (Gateway 1)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_CURRENCY=brl

# Mercado Pago (Gateway 2)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-placeholder-access-token
MERCADOPAGO_WEBHOOK_SECRET=placeholder_secret

# E-mail (Nodemailer - Mailtrap / SendGrid / SES)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_user
SMTP_PASS=placeholder_pass
SMTP_FROM="Nexus Shop <nao-responda@nexusshop.com>"
