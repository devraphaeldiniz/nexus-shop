# ==========================================
# NEXUS SHOP - SERVER ENVIRONMENT CONFIG
# ==========================================
# Em NODE_ENV=production a API não sobe sem: FRONTEND_URL, DATABASE_URL, REDIS_URL,
# JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, SETTINGS_ENCRYPTION_KEY. (SMTP é opcional: sem ele a loja não envia e-mails.)

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexus_user:nexus_password123@localhost:5433/nexus_shop?schema=public

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379

# JWT Authentication (32+ caracteres; em produção são obrigatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-valor-access-secret-com-32-caracteres
JWT_REFRESH_SECRET=troque-este-valor-refresh-secret-com-32-caracteres

# Criptografia das chaves de pagamento salvas no painel (32+ caracteres; obrigatório em produção).
# Se mudar, as chaves já salvas precisam ser cadastradas de novo no painel.
SETTINGS_ENCRYPTION_KEY=troque-este-valor-chave-de-criptografia-32+

# URL pública da API (usada como notification_url do Mercado Pago). Ex.: https://api.sualoja.com.br
API_PUBLIC_URL=

# Cookies de sessão: lax (front e API no mesmo site) | none (domínios diferentes, exige HTTPS) | strict
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Token exigido na tela /setup para criar o primeiro administrador (opcional, recomendado em produção)
SETUP_TOKEN=

# Contas de demonstração na tela de login (senha pública; admin demo é somente leitura).
# Fora de produção ficam ligadas; em produção só com true (rode o seed:prod com DEMO_ACCOUNTS=true para criá-las)
DEMO_ACCOUNTS=

# Requisições por minuto por IP (padrão: 120 em produção, 1000 fora)
RATE_LIMIT_MAX=

# Seed de produção (npm run prisma:seed:prod): cria o admin só se as duas estiverem definidas
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed de desenvolvimento (npm run prisma:seed): se vazias, senhas aleatórias são geradas e exibidas
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Origens extras liberadas no CORS, separadas por vírgula (FRONTEND_URL já é liberada)
CORS_ORIGIN=

# Stripe (Gateway 1)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_CURRENCY=brl
# Chave pública enviada ao checkout (se não estiver no painel admin)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key

# Mercado Pago (Gateway 2)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-placeholder-access-token
MERCADOPAGO_WEBHOOK_SECRET=placeholder_secret

# E-mail (Nodemailer - Mailtrap / SendGrid / SES)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_user
SMTP_PASS=placeholder_pass
SMTP_FROM="Nexus Shop <nao-responda@nexusshop.com>"
