# Desenvolvimento: front chama a API direto
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Produção (recomendado): o Next faz proxy de /api/v1 para a API, mantendo os cookies no domínio do front
# NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_TARGET=https://sua-api.onrender.com

# E2E (Playwright): senha do cliente do seed (SEED_CUSTOMER_PASSWORD)
# E2E_CUSTOMER_PASSWORD=
